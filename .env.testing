APP_NAME="Drafto Test"
APP_ENV=testing
# APP_KEY não é versionada aqui de propósito: é gerada em tempo de execução
# (workflow de CI roda `php artisan key:generate --show` e exporta como
# variável de ambiente real, que tem precedência sobre este arquivo).
# Localmente, gere a sua com: php artisan key:generate --env=testing
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array
