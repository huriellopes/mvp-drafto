includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    # Level 9 is the highest level
    level: 5

    treatPhpDocTypesAsCertain: false

    # Padrões de ignore podem ficar obsoletos conforme o código evolui;
    # não falhar a análise por isso (o baseline cobre a dívida atual).
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model#'
        - '#Access to an undefined property App\\Livewire\\#'
        - '#Call to an undefined method App\\Livewire\\#'
        - '#Relation .* is not found in .* model#'
        - '#Using nullsafe property access .* is unnecessary#'
        - '#Cannot call method .* on string#'
        - '#Cannot access property .* on string#'
        - '#Static method RalphJSmit\\Laravel\\SEO\\SchemaCollection.* invoked with 1 parameter, 0 required#'
        - '#Access to an undefined property App\\Models\\Profile::\$username#'
        - '#Access to an undefined property App\\Models\\Collection::\$is_public#'
        - '#Access to an undefined property App\\Models\\Comment::\$depth#'
        - '#Access to an undefined property App\\Models\\Post::\$cover_image_url#'
        - '#Call to function is_array\(\) with \*NEVER\* will always evaluate to true#'
        - '#Offset mixed on \*NEVER\* on left side of \?\? always exists and is not nullable#'
        - '#Call to an undefined method Illuminate\\Contracts\\Pagination\\LengthAwarePaginator::setCollection\(\)#'
        - '#Call to an undefined method Illuminate\\Contracts\\Pagination\\LengthAwarePaginator::getCollection\(\)#'
        - '#Parameter \#1 \$items of static method Illuminate\\Support\\Collection<.*>::make\(\) expects .* given#'
        - '#Parameter \$published_time of class RalphJSmit\\Laravel\\SEO\\Support\\SEOData constructor expects Carbon\\CarbonInterface\|null, string\|null given#'
        - '#Using nullsafe property access on non-nullable type Illuminate\\Database\\Eloquent\\Model\. Use -> instead#'

        # Atributos dinâmicos de pivot (withPivot) não são conhecidos estaticamente pelo Eloquent.
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Relations\\Pivot::\$(is_enabled|settings)#'
        # Local scopes chamados sobre objetos de Relation (ex.: $post->comments()->root()) — funcionam via __call em runtime.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::root\(\)#'
        # maatwebsite/excel FromQuery::query() declara retorno incluindo Laravel\Scout\Builder, dependência opcional não instalada.
        - '#Method App\\Exports\\.*Export::query\(\) has invalid return type Laravel\\Scout\\Builder#'
        # match() exaustivo sobre o enum Monolog\Level: o último arm/default é redundante por exaustividade.
        - '#Match arm comparison between Monolog\\Level::[A-Za-z]+ and Monolog\\Level::[A-Za-z]+ is always true#'

    excludePaths:
        # - ./*/*/FileToBeExcluded.php
